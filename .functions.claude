# wt — launch an isolated Claude Code session in a git worktree
#
# Sourced by .zshrc as a topic file; symlinked into ~ by install.sh.
# Interactive shells only — wt cd's you into the worktree, so it has to be
# a function in your shell, not a script in ~/.local/bin.
#
# Every operation takes an explicit command. There is no bare `wt`.
#
# Usage:
#   wt list                worktrees with session id, status, description
#   wt new [branch]        create worktree + session, launch claude
#                          branch defaults to the next free wt/N
#   wt resume <ref>        cd back into a worktree, resume its session
#   wt rm <ref>            remove worktree and delete its branch
#   wt help                this text
#
# <ref> is a session-id prefix (like a short sha), a branch name, or a
# worktree directory name. Args after `new`/`resume` pass through to claude.
#
# Worktrees live under ~/.worktrees/<repo>/<name>, not beside the repo, so
# your project directory only ever holds real checkouts. When claude exits,
# `new` and `resume` ask whether to keep the worktree and then put you back
# in the directory you started from — a session never strands you somewhere
# you didn't choose to be.
#
# Each worktree owns a Claude session id, minted here and handed to claude
# via --session-id, so `wt resume` lands in the same conversation every time.
# It lives in worktree-scoped git config (wt.sessionId), which keeps it out
# of `git status` — see _wt_session.
#
# Env:
#   WT_SAFE=1              launch with permission prompts enabled
#   WT_NO_LAUNCH=1         set up the worktree and cd there, don't launch
#   WT_DIR=<path>          worktree root (default: ~/.worktrees)
#   WT_KEEP=1              skip the on-exit prompt, always keep the worktree

wt() {
  local cmd=$1 root

  case "$cmd" in
    help|-h|--help) _wt_usage; return 0 ;;
    "") _wt_usage >&2; return 1 ;;
  esac
  shift

  command -v git >/dev/null 2>&1 || {
    echo "wt: git is not installed" >&2
    return 1
  }
  # Guard here so every command inherits it — _wt_remove used to dispatch
  # ahead of this check and fail silently outside a repo.
  root=$(_wt_root) || {
    echo "wt: not inside a git repository" >&2
    return 1
  }

  case "$cmd" in
    list|ls)   _wt_list "$root" "$@" ;;
    new)       _wt_new "$root" "$@" ;;
    resume|cd) _wt_resume "$root" "$@" ;;
    rm|remove) _wt_remove "$root" "$@" ;;
    *) echo "wt: unknown command '$cmd' — try: wt help" >&2; return 1 ;;
  esac
}

_wt_usage() {
  cat <<'USAGE'
usage: wt <command> [args]

  wt list                worktrees with session id, status, description
  wt new [branch]        create worktree + session, launch claude
                         branch defaults to the next free wt/N
  wt resume <ref>        cd back into a worktree, resume its session
  wt rm <ref>            remove worktree and delete its branch
  wt help                this text

<ref> is a session-id prefix, a branch name, or a worktree directory name.
Args after `new`/`resume` pass through to claude.

Worktrees live under ~/.worktrees/<repo>/. On exit you're asked whether to
keep the worktree, then returned to the directory you started from.
USAGE
}

# Path of the MAIN worktree, even when called from inside a linked one.
# rev-parse --show-toplevel would return the linked worktree instead, which
# made names compound (repo-a -> repo-a-b) and broke `wt rm` from inside.
# `worktree list` always reports the main worktree first.
#
# Bare repos are allowed: worktrees are the point of a bare checkout. We test
# --git-dir rather than --is-inside-work-tree because the latter PRINTS false
# in a bare repo while still EXITING 0, so the old check let bare repos through
# by accident instead of on purpose.
_wt_root() {
  local first
  git rev-parse --git-dir >/dev/null 2>&1 || return 1
  first=$(git worktree list --porcelain 2>/dev/null | head -1 | cut -d' ' -f2-)
  [ -n "$first" ] || return 1
  printf '%s\n' "$first"
}

# Directory holding this repo's worktrees. Kept out of the project directory
# on purpose: siblings named repo-wt-1 clutter every `ls` and outlive the
# session that made them. Strips a bare repo's .git suffix, which used to
# leak into names as repo.git-branch.
_wt_home() {
  local root=$1 repo
  repo=$(basename "${root%.git}")
  printf '%s\n' "${WT_DIR:-$HOME/.worktrees}/${repo}"
}

_wt_uuid() {
  local u
  if command -v uuidgen >/dev/null 2>&1; then
    u=$(uuidgen)
  elif [ -r /proc/sys/kernel/random/uuid ]; then
    u=$(cat /proc/sys/kernel/random/uuid)
  else
    echo "wt: no uuidgen found, cannot mint a session id" >&2
    return 1
  fi
  printf '%s' "$u" | tr '[:upper:]' '[:lower:]'
  echo
}

# Read/write a worktree-scoped setting. Worktree-scoped config needs
# extensions.worktreeConfig on the repo; setting it is idempotent.
_wt_cfg() {
  local dir=$1 key=$2 val=$3
  if [ -n "$val" ]; then
    git -C "$dir" config extensions.worktreeConfig true
    git -C "$dir" config --worktree "$key" "$val"
  else
    git -C "$dir" config --worktree "$key" 2>/dev/null
  fi
}

# The Claude session this worktree owns.
_wt_session() { _wt_cfg "$1" wt.sessionId "$2"; }

# The commit the worktree branched from, so the exit prompt can say how much
# work would go with it. Recorded at creation because the main worktree's
# HEAD moves underneath us.
_wt_base() { _wt_cfg "$1" wt.base "$2"; }

# Where claude keeps a session's transcript: project dirs are the cwd with
# / and . flattened to dashes.
_wt_transcript() {
  local slug
  slug=$(printf '%s' "$1" | tr './' '--')
  printf '%s\n' "$HOME/.claude/projects/$slug/$2.jsonl"
}

_wt_next_branch() {
  local root=$1 home n=1
  home=$(_wt_home "$root")
  while git -C "$root" show-ref --verify --quiet "refs/heads/wt/$n" \
     || [ -d "$home/wt-$n" ]; do
    n=$((n + 1))
  done
  printf 'wt/%s\n' "$n"
}

# Emit path<TAB>branch<TAB>sessionId for every worktree, main one first.
_wt_scan() {
  local root=$1 line wtpath branch
  while IFS= read -r line; do
    case "$line" in
      worktree\ *) wtpath=${line#worktree }; branch= ;;
      branch\ *)   branch=${line#branch refs/heads/} ;;
      detached)    branch='(detached)' ;;
      bare)        branch='(bare)' ;;
      '')          [ -n "$wtpath" ] && _wt_scan_row "$wtpath" "$branch"; wtpath=; branch= ;;
    esac
  done < <(git -C "$root" worktree list --porcelain 2>/dev/null)
  [ -n "$wtpath" ] && _wt_scan_row "$wtpath" "$branch"
}

_wt_scan_row() {
  printf '%s\t%s\t%s\n' "$1" "${2:-?}" "$(_wt_session "$1")"
}

# sessionId<TAB>status<TAB>description for the given ids.
#   status      from ~/.claude/sessions/<pid>.json (live sessions only)
#   description first real prompt, from ~/.claude/history.jsonl
# There is no summary stored anywhere in ~/.claude, so the opening prompt is
# the best description available.
_wt_meta() {
  [ $# -eq 0 ] && return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$@" <<'PYEOF'
import glob, json, os, sys

want = set(sys.argv[1:])
status, desc = {}, {}

for f in glob.glob(os.path.expanduser("~/.claude/sessions/*.json")):
    try:
        d = json.load(open(f))
    except Exception:
        continue
    if d.get("sessionId") in want:
        status[d["sessionId"]] = d.get("status", "")

hist = os.path.expanduser("~/.claude/history.jsonl")
if os.path.exists(hist):
    for line in open(hist, errors="replace"):
        try:
            d = json.loads(line)
        except Exception:
            continue
        sid = d.get("sessionId")
        if sid not in want or sid in desc:
            continue
        text = " ".join((d.get("display") or "").split())
        if len(text) < 12 or text.startswith("/"):
            continue          # slash commands and noise like "exit"
        desc[sid] = text

for sid in want:
    print("%s\t%s\t%s" % (sid, status.get(sid, ""), desc.get(sid, "")))
PYEOF
}

_wt_list() {
  local root=$1 wtpath branch sid line sstat desc mark disp cols width i
  local -a paths=() branches=() sids=()
  local -A st=() ds=()

  while IFS=$'\t' read -r wtpath branch sid; do
    paths+=("$wtpath"); branches+=("$branch"); sids+=("$sid")
  done < <(_wt_scan "$root")

  while IFS=$'\t' read -r sid sstat desc; do
    st[$sid]=$sstat; ds[$sid]=$desc
  done < <(_wt_meta ${(u)sids:#})

  cols=${COLUMNS:-100}
  width=$((cols - 60))
  [ $width -lt 20 ] && width=20

  printf '  %-8s  %-14s  %-30s  %s\n' SESSION BRANCH PATH DESCRIPTION
  for ((i = 1; i <= ${#paths[@]}; i++)); do
    wtpath=${paths[$i]}; branch=${branches[$i]}; sid=${sids[$i]}
    disp=${wtpath/#$HOME/\~}
    [ ${#disp} -gt 30 ] && disp="…${disp: -29}"
    [ "$wtpath" = "$root" ] && desc='(main worktree)' || desc=${ds[$sid]:-}
    mark=' '
    case ${st[$sid]:-} in
      busy) mark='*' ;;
      idle|waiting) mark='.' ;;
    esac
    printf '%s %-8s  %-14s  %-30s  %.*s\n' \
      "$mark" "${sid:0:8}" "${branch:0:14}" "$disp" "$width" "$desc"
  done
  [ ${#paths[@]} -le 1 ] && echo "\nno linked worktrees — create one with: wt new"
  return 0
}

_wt_new() {
  local root=$1; shift
  local branch=$1 name dir sid home origin=$PWD
  [ $# -gt 0 ] && shift
  [ -z "$branch" ] && branch=$(_wt_next_branch "$root")

  name=${branch//\//-}
  home=$(_wt_home "$root")
  dir=$home/$name

  [ -e "$dir" ] && {
    echo "wt: $dir already exists — use: wt resume $branch" >&2
    return 1
  }
  mkdir -p "$home" || return 1

  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$root" worktree add "$dir" "$branch" || return 1
  else
    git -C "$root" worktree add "$dir" -b "$branch" || return 1
  fi

  sid=$(_wt_uuid) || return 1
  _wt_session "$dir" "$sid"
  _wt_base "$dir" "$(git -C "$dir" rev-parse HEAD 2>/dev/null)"

  cd "$dir" || return 1
  echo "wt: branch $branch, session ${sid:0:8}"
  _wt_report_ignored "$root" "$dir"
  [ -n "$WT_NO_LAUNCH" ] && return 0
  _wt_launch --session-id "$sid" "$@"
  _wt_finish "$root" "$dir" "$origin"
}

_wt_resume() {
  local root=$1; shift
  local ref=$1 dir sid origin=$PWD
  [ -z "$ref" ] && {
    echo "wt resume: need a session id, branch, or worktree name" >&2
    return 1
  }
  shift
  dir=$(_wt_resolve "$root" "$ref") || return 1
  sid=$(_wt_session "$dir")

  cd "$dir" || return 1
  _wt_report_ignored "$root" "$dir"
  [ -n "$WT_NO_LAUNCH" ] && return 0

  # --session-id creates, --resume reattaches. Only reattach once claude has
  # actually written a transcript, or it errors on an unknown session.
  if [ -z "$sid" ]; then
    echo "wt: no session recorded here, starting a fresh one" >&2
    sid=$(_wt_uuid) && _wt_session "$dir" "$sid" && _wt_launch --session-id "$sid" "$@"
  elif [ -f "$(_wt_transcript "$dir" "$sid")" ]; then
    _wt_launch --resume "$sid" "$@"
  else
    _wt_launch --session-id "$sid" "$@"
  fi
  _wt_finish "$root" "$dir" "$origin"
}

# Resolve a session-id prefix, branch name, or worktree dir name to a path.
# The main worktree is never a candidate — it isn't ours to resume or remove.
_wt_resolve() {
  local root=$1 ref=$2 wtpath branch sid
  local -a hits=()
  while IFS=$'\t' read -r wtpath branch sid; do
    [ "$wtpath" = "$root" ] && continue
    if [ -n "$sid" ] && [ "${sid#$ref}" != "$sid" ]; then
      hits+=("$wtpath")
    elif [ "$branch" = "$ref" ] || [ "$(basename "$wtpath")" = "$ref" ]; then
      hits+=("$wtpath")
    fi
  done < <(_wt_scan "$root")

  case ${#hits[@]} in
    1) printf '%s\n' "${hits[1]}" ;;
    0) echo "wt: no worktree matching '$ref'" >&2; return 1 ;;
    *) echo "wt: '$ref' is ambiguous:" >&2
       printf '  %s\n' "${hits[@]}" >&2
       return 1 ;;
  esac
}

# Report the gitignored paths that exist in the source checkout but are absent
# from $dst. Copies nothing and installs nothing: git carries only tracked
# files, so this is an honest inventory of what is missing — deps, .env, sample
# data — letting the session be asked for whatever it actually needs.
#
# Runs on both `wt new` and `wt resume`. Because it tests the destination for
# each path rather than assuming a bare checkout, a resume only reports what is
# STILL missing: anything an earlier session reconciled drops off the list.
#
# Sizes come from du so bulk (a 245M .venv) is distinguishable from a 300B
# .env at a glance. Set WT_IGNORED_LIMIT to change how many paths are listed;
# the count is always the true total.
_wt_report_ignored() {
  local src=$1 dst=$2 entry bare size shown=0 total=0
  local limit=${WT_IGNORED_LIMIT:-20}
  local -a lines

  while IFS= read -r entry; do
    bare=${entry%/}
    case "$entry" in
      */)
        # --directory also collapses dirs that are merely untracked (every file
        # inside happens to be ignored). git lists those files individually, so
        # reporting the dir too would double-count — only report dirs an ignore
        # RULE actually matches.
        git -C "$src" check-ignore -q "$entry" || continue ;;
    esac

    [ -e "$dst/$bare" ] && continue
    total=$((total + 1))
    [ "$shown" -ge "$limit" ] && continue
    size=$(du -sh "$src/$bare" 2>/dev/null | cut -f1)
    lines+=("$(printf '%7s  %s' "${size:-?}" "$entry")")
    shown=$((shown + 1))
  done < <(git -C "$src" -c core.quotePath=false ls-files \
             --others --ignored --exclude-standard --directory)

  [ "$total" -eq 0 ] && return 0

  {
    echo "wt: $total gitignored path(s) exist in $src but NOT here:"
    [ ${#lines[@]} -gt 0 ] && printf '       %s\n' "${lines[@]}"
    [ "$total" -gt "$shown" ] && echo "       … and $((total - shown)) more"
    echo "wt: nothing was copied — ask the session to set up what it needs."
  } >&2
  return 0
}

_wt_launch() {
  local -a cmd=()
  command -v caffeinate >/dev/null 2>&1 && cmd=(caffeinate -dims)
  cmd+=(claude)
  [ -z "$WT_SAFE" ] && cmd+=(--dangerously-skip-permissions)
  echo "wt: ${cmd[*]} $*"
  "${cmd[@]}" "$@"
}

_wt_remove() {
  local root=$1 ref=$2 dir
  [ -z "$ref" ] && {
    echo "wt rm: need a session id, branch, or worktree name" >&2
    return 1
  }
  dir=$(_wt_resolve "$root" "$ref") || return 1
  _wt_destroy "$root" "$dir"
}

# Tear down a worktree by path. Split out of _wt_remove so _wt_finish can
# reuse it without round-tripping through _wt_resolve, which matches on
# names the caller has already resolved past.
#
# The branch outlives a forced removal on purpose: `branch -d` refuses
# unmerged work, so committed work survives even when you asked to drop the
# tree in a hurry.
_wt_destroy() {
  local root=$1 dir=$2 force=$3 branch
  # Read the branch before the worktree goes away.
  branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)

  # Don't delete the tree you're standing in.
  case "$PWD" in "$dir"|"$dir"/*) cd "$root" || return 1 ;; esac

  git -C "$root" worktree remove ${force:+--force} "$dir" || {
    echo "wt: uncommitted changes in $dir — use: git -C '$root' worktree remove --force '$dir'" >&2
    return 1
  }
  [ -n "$branch" ] && [ "$branch" != HEAD ] && {
    git -C "$root" branch -d "$branch" 2>/dev/null || \
      echo "wt: branch '$branch' not fully merged, kept. Delete with: git branch -D '$branch'"
  }
}

# Called once claude exits. Offers to drop the worktree, then returns you to
# the directory you ran `wt` from. Landing back where you started is the
# point: you asked for a session, not for a new home.
#
# We cd out FIRST so the prompt is answered from solid ground and a removal
# can't pull the floor out from under the shell.
_wt_finish() {
  local root=$1 dir=$2 origin=$3 branch sid base dirty ahead summary reply

  case "$origin" in "$dir"|"$dir"/*) origin=$root ;; esac
  [ -d "$origin" ] || origin=$root
  cd "$origin" 2>/dev/null || cd "$root" || return 1

  [ -d "$dir" ] || return 0

  branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
  sid=$(_wt_session "$dir")
  [ -n "$WT_KEEP" ] && { _wt_kept "$dir" "$sid" "$branch"; return 0; }

  dirty=$(git -C "$dir" status --porcelain 2>/dev/null | grep -c .)
  base=$(_wt_base "$dir")
  [ -z "$base" ] && base=$(git -C "$root" rev-parse HEAD 2>/dev/null)
  ahead=$(git -C "$dir" rev-list --count "$base"..HEAD 2>/dev/null) || ahead=0

  summary=
  [ "${ahead:-0}" -gt 0 ] && summary="$ahead commit(s)"
  [ "${dirty:-0}" -gt 0 ] && summary="${summary:+$summary, }$dirty uncommitted file(s)"

  # Non-interactive shells never get to answer, so they never lose anything.
  [ -t 0 ] || { _wt_kept "$dir" "$sid" "$branch"; return 0; }

  if [ -z "$summary" ]; then
    read -r "reply?wt: $branch has nothing to keep — remove it? [Y/n] "
    case "$reply" in [Nn]*) _wt_kept "$dir" "$sid" "$branch"; return 0 ;; esac
    _wt_destroy "$root" "$dir"
  else
    read -r "reply?wt: $branch has $summary — remove it anyway? [y/N] "
    case "$reply" in
      [Yy]*) _wt_destroy "$root" "$dir" force ;;
      *)     _wt_kept "$dir" "$sid" "$branch" ;;
    esac
  fi
}

_wt_kept() {
  local dir=$1 ref=${2:0:8}
  [ -z "$ref" ] && ref=$3
  echo "wt: kept ${dir/#$HOME/~}"
  [ -n "$ref" ] && echo "    resume: wt resume $ref     remove: wt rm $ref"
  return 0
}
