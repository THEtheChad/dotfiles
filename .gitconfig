[user]
  name = user
  email = user@example.com
[core]
  excludesfile = ~/Configs/.gitignore
[github]
  user = user
[color]
  ui = always
[alias]
  co = checkout
  ci = commit
  st = status
  br = branch
  hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
  type = cat-file -t
  dump = cat-file -p
