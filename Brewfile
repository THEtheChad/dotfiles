# Install with: brew bundle
brew "git"
brew "jq"
brew "ripgrep"   # replaces gref.sh
brew "zoxide"    # replaces z.sh; wired up via the oh-my-zsh zoxide plugin
brew "tmux"
brew "fzf"       # fuzzy finder; keybindings via the oh-my-zsh fzf plugin
brew "fd"        # friendlier find
brew "bat"       # cat with syntax highlighting and paging
brew "eza"       # modern ls
brew "ffmpeg"    # for gifify
brew "gifsicle"  # for gifify
brew "imagemagick" # for gifify --good
